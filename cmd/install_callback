#!/bin/bash
# OpenClaw 安装回调脚本
# 在用户安装应用后调用，用于初始化 openclaw.json 配置
#
# 根据用户的当前执行权限，会生成在 root 的家目录

# 日志文件路径
LOG_FILE="${TRIM_PKGVAR}/info.log"
PKGVAR="/var/apps/${TRIM_APPNAME}/var"
TARGET="/var/apps/${TRIM_APPNAME}/target"
# Node.js 可执行文件路径
NODE_PATH="/var/apps/nodejs_v22/target/bin/node"
NPM_PATH="/var/apps/nodejs_v22/target/bin/npm"

OPENCLAW_BIN="${PKGVAR}/node_modules/.bin/openclaw" # openclaw bin 路径
GATEWAY_PORT="${GATEWAY_PORT:-18789}"
CONFIG_PATCH_SCRIPT="${TARGET}/server/scripts/apply-default-config.js"


# 记录日志消息
# 参数: $1 - 要记录的消息内容
log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

run_with_timeout() {
    local limit="$1"
    shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "${limit}" "$@"
    else
        "$@"
    fi
}

resolve_runtime_binaries() {
    if [ -x "${NODE_PATH}" ]; then
        NODE_BIN="${NODE_PATH}"
    else
        NODE_BIN="$(command -v node || true)"
    fi

    if [ -x "${NPM_PATH}" ]; then
        NPM_BIN="${NPM_PATH}"
    else
        NPM_BIN="$(command -v npm || true)"
    fi

    if [ -z "${NODE_BIN}" ] || [ -z "${NPM_BIN}" ]; then
        echo "Node.js/npm not found in install_callback" > "${TRIM_TEMP_LOGFILE}"
        echo "NODE_PATH=${NODE_PATH}" >> "${TRIM_TEMP_LOGFILE}"
        echo "NPM_PATH=${NPM_PATH}" >> "${TRIM_TEMP_LOGFILE}"
        exit 1
    fi

    log_msg "Using node binary: ${NODE_BIN}"
    log_msg "Using npm binary: ${NPM_BIN}"
}

resolve_config_patch_script() {
    if [ -f "${CONFIG_PATCH_SCRIPT}" ]; then
        log_msg "Using config patch script: ${CONFIG_PATCH_SCRIPT}"
        return 0
    fi

    local legacy_path="${TARGET}/app/server/scripts/apply-default-config.js"
    if [ -f "${legacy_path}" ]; then
        CONFIG_PATCH_SCRIPT="${legacy_path}"
        log_msg "Using legacy config patch script: ${CONFIG_PATCH_SCRIPT}"
        return 0
    fi

    log_msg "Config patch script not found in expected paths"
    return 1
}

# 根据用户选择设置配置路径（兼容缺省值）
case "${TRIM_WIZARD_config_location:-root}" in
    appdir)
        export HOME="${PKGVAR}"
        export OPENCLAW_CONFIG_PATH="${PKGVAR}/.openclaw/openclaw.json"
        log_msg "Config location selected: appdir (${OPENCLAW_CONFIG_PATH})"
        ;;
    root)
        export HOME="/root"
        export OPENCLAW_CONFIG_PATH="/root/.openclaw/openclaw.json"
        log_msg "Config location selected: root (${OPENCLAW_CONFIG_PATH})"
        ;;
    *)
        export HOME="/root"
        export OPENCLAW_CONFIG_PATH="/root/.openclaw/openclaw.json"
        log_msg "Unknown config location '${TRIM_WIZARD_config_location}', fallback to root (${OPENCLAW_CONFIG_PATH})"
        ;;
esac
export PATH="/var/apps/nodejs_v22/target/bin:${PKGVAR}/node_modules/.bin:$PATH"
export GATEWAY_PORT

# 安装 openclaw 最新版本
# 在指定目录下安装 openclaw@latest
# 支持多镜像源切换和重试机制
install_openclaw() {
    local OPENCLAW_BIN="${PKGVAR}/node_modules/.bin/openclaw"
    local INSTALL_TIMEOUT_SECONDS="${OC_INSTALL_TIMEOUT_SECONDS:-300}"
    local DISCOVERY_TIMEOUT_SECONDS="${OC_INSTALL_DISCOVERY_TIMEOUT_SECONDS:-20}"
    log_msg "Installing openclaw@latest in ${PKGVAR}..."

    local REGISTRIES=(
        "https://registry.npmmirror.com/"
        "https://mirrors.cloud.tencent.com/npm/"
        "https://registry.npmjs.org/"
    )

    local INSTALL_SUCCESS=0

    # 连通性检测：优先用 npm view（更贴近真实安装链路），失败时退回 curl 首页探测。
    log_msg "Testing registry connectivity..."
    local WORKING_REGISTRIES=()
    for REGISTRY in "${REGISTRIES[@]}"; do
        if run_with_timeout "${DISCOVERY_TIMEOUT_SECONDS}" "${NPM_BIN}" view openclaw version --registry="${REGISTRY}" >/dev/null 2>&1; then
            WORKING_REGISTRIES+=("${REGISTRY}")
            log_msg "✓ ${REGISTRY} reachable (npm view)"
        elif run_with_timeout 3 curl -sf "${REGISTRY}" >/dev/null 2>&1; then
            WORKING_REGISTRIES+=("${REGISTRY}")
            log_msg "✓ ${REGISTRY} reachable (curl fallback)"
        else
            log_msg "✗ ${REGISTRY} unreachable, skipping"
        fi
    done

    # 如果没有可用镜像源，使用全部列表
    if [ ${#WORKING_REGISTRIES[@]} -eq 0 ]; then
        log_msg "No registries passed connectivity test, trying all anyway"
        WORKING_REGISTRIES=("${REGISTRIES[@]}")
    fi

    # 尝试可用镜像源（默认 300s，可通过 OC_INSTALL_TIMEOUT_SECONDS 覆盖）
    for REGISTRY in "${WORKING_REGISTRIES[@]}"; do
        log_msg "Trying ${REGISTRY}..."
        rm -rf "${PKGVAR}/node_modules/openclaw" "${PKGVAR}/package-lock.json" 2>/dev/null

        cd "${PKGVAR}" && run_with_timeout "${INSTALL_TIMEOUT_SECONDS}" "${NPM_BIN}" install openclaw@latest \
            --registry="${REGISTRY}" \
            --no-audit \
            --no-fund \
            --prefer-online \
            --fetch-timeout=30000 \
            --fetch-retries=2 >> "${LOG_FILE}" 2>&1

        if [ $? -eq 0 ]; then
            log_msg "Successfully installed with ${REGISTRY}"
            INSTALL_SUCCESS=1
            break
        fi
    done

    # 版本降级（仅尝试最近 2 个稳定版本）
    if [ $INSTALL_SUCCESS -eq 0 ]; then
        log_msg "Trying version fallback..."

        local VERSIONS_JSON
        local VERSIONS
        VERSIONS_JSON="$(cd "${PKGVAR}" && run_with_timeout "${DISCOVERY_TIMEOUT_SECONDS}" "${NPM_BIN}" view openclaw versions --json --registry="${REGISTRIES[0]}" 2>>"${LOG_FILE}" || true)"
        VERSIONS="$(printf '%s' "${VERSIONS_JSON}" | "${NODE_BIN}" -e '
const fs = require("fs");
let raw = "";
try { raw = fs.readFileSync(0, "utf8"); } catch (_) {}
if (!raw.trim()) process.exit(0);
let parsed;
try { parsed = JSON.parse(raw); } catch (_) { process.exit(0); }
const list = Array.isArray(parsed) ? parsed : [parsed];
const stable = list
  .map((v) => String(v || "").trim())
  .filter((v) => v && !/beta|alpha|rc/i.test(v));
const picked = stable.slice(-2).reverse();
process.stdout.write(picked.join("\n"));
' 2>/dev/null)"

        if [ -n "$VERSIONS" ]; then
            for VERSION in $VERSIONS; do
                log_msg "Trying openclaw@${VERSION}..."
                rm -rf "${PKGVAR}/node_modules/openclaw" "${PKGVAR}/package-lock.json" 2>/dev/null

                cd "${PKGVAR}" && run_with_timeout "${INSTALL_TIMEOUT_SECONDS}" "${NPM_BIN}" install openclaw@${VERSION} \
                    --registry="${REGISTRIES[0]}" \
                    --no-audit \
                    --no-fund \
                    --prefer-online \
                    --fetch-timeout=30000 \
                    --fetch-retries=2 >> "${LOG_FILE}" 2>&1

                if [ $? -eq 0 ]; then
                    log_msg "Successfully installed openclaw@${VERSION}"
                    INSTALL_SUCCESS=1
                    break
                fi
            done
        fi
    fi

    # 失败处理
    if [ $INSTALL_SUCCESS -eq 0 ]; then
        log_msg "All installation attempts failed"
        echo "========================================" > "$TRIM_TEMP_LOGFILE"
        echo "OpenClaw 安装失败" >> "$TRIM_TEMP_LOGFILE"
        echo "========================================" >> "$TRIM_TEMP_LOGFILE"
        echo "" >> "$TRIM_TEMP_LOGFILE"
        echo "【镜像源连通性测试结果】" >> "$TRIM_TEMP_LOGFILE"
        for REGISTRY in "${REGISTRIES[@]}"; do
            if run_with_timeout "${DISCOVERY_TIMEOUT_SECONDS}" "${NPM_BIN}" view openclaw version --registry="${REGISTRY}" >/dev/null 2>&1; then
                echo "  ✓ ${REGISTRY} - npm view 可访问" >> "$TRIM_TEMP_LOGFILE"
            elif run_with_timeout 3 curl -sf "${REGISTRY}" >/dev/null 2>&1; then
                echo "  ✓ ${REGISTRY} - curl 可访问（npm view 失败）" >> "$TRIM_TEMP_LOGFILE"
            else
                echo "  ✗ ${REGISTRY} - 无法访问" >> "$TRIM_TEMP_LOGFILE"
            fi
        done
        echo "" >> "$TRIM_TEMP_LOGFILE"
        echo "【尝试的安装方法】" >> "$TRIM_TEMP_LOGFILE"
        echo "  1. 使用可访问的镜像源安装 openclaw@latest" >> "$TRIM_TEMP_LOGFILE"
        echo "  2. 降级到最近 2 个稳定版本" >> "$TRIM_TEMP_LOGFILE"
        echo "" >> "$TRIM_TEMP_LOGFILE"
        echo "【可能的原因】" >> "$TRIM_TEMP_LOGFILE"
        echo "  - 网络连接问题（DNS 解析失败、防火墙拦截）" >> "$TRIM_TEMP_LOGFILE"
        echo "  - npm 镜像源暂时不可用" >> "$TRIM_TEMP_LOGFILE"
        echo "  - 磁盘空间不足" >> "$TRIM_TEMP_LOGFILE"
        echo "" >> "$TRIM_TEMP_LOGFILE"
        echo "【详细日志（最后 50 行）】" >> "$TRIM_TEMP_LOGFILE"
        tail -n 50 "${LOG_FILE}" >> "$TRIM_TEMP_LOGFILE"
        echo "" >> "$TRIM_TEMP_LOGFILE"
        echo "完整日志: ${LOG_FILE}" >> "$TRIM_TEMP_LOGFILE"
        exit 1
    fi

    # 2. 验证安装：尝试执行二进制文件并获取版本号
    log_msg "Verifying openclaw binary execution..."

    # 验证步骤：
    # a. 检查二进制文件是否存在
    # b. 使用指定的 NODE_PATH 尝试运行该文件并获取版本信息
    if [ -f "$OPENCLAW_BIN" ] && "${NODE_BIN}" "$OPENCLAW_BIN" --version >> ${LOG_FILE} 2>&1; then
        log_msg "openclaw@latest installed and verified successfully"
        # 获取具体的版本号并记录到日志中
        local VERSION=$("${NODE_BIN}" "$OPENCLAW_BIN" --version 2>/dev/null)
        log_msg "Detected version: $VERSION"
        return 0
    else
        # 验证失败的处理逻辑
        log_msg "Error: openclaw binary verification failed. Installation might be corrupted."
        echo "Failed to verify openclaw@latest installation." > "$TRIM_TEMP_LOGFILE"
        echo "" >> "$TRIM_TEMP_LOGFILE"
        echo "Binary path: ${OPENCLAW_BIN}" >> "$TRIM_TEMP_LOGFILE"
        echo "Binary exists: $([ -f "$OPENCLAW_BIN" ] && echo 'Yes' || echo 'No')" >> "$TRIM_TEMP_LOGFILE"
        echo "" >> "$TRIM_TEMP_LOGFILE"
        echo "Last 20 lines of log:" >> "$TRIM_TEMP_LOGFILE"
        tail -n 20 "${LOG_FILE}" >> "$TRIM_TEMP_LOGFILE"
        echo "" >> "$TRIM_TEMP_LOGFILE"
        echo "Possible causes:" >> "$TRIM_TEMP_LOGFILE"
        echo "  - Incomplete installation" >> "$TRIM_TEMP_LOGFILE"
        echo "  - Node.js version mismatch" >> "$TRIM_TEMP_LOGFILE"
        echo "  - Missing dependencies" >> "$TRIM_TEMP_LOGFILE"
        echo "" >> "$TRIM_TEMP_LOGFILE"
        echo "Full log: ${LOG_FILE}" >> "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
}

# 初始化 openclaw 配置
# 运行 openclaw setup 命令生成配置文件
setup_openclaw_config() {
    local CONFIG_FILE="${OPENCLAW_CONFIG_PATH}"
    local CLEAN_OLD_CONFIG="${TRIM_WIZARD_clean_old_config:-yes}"

    # 用户选择“不覆盖”且目标配置已存在时，跳过 setup/patch，避免覆盖已有配置。
    if [ "${CLEAN_OLD_CONFIG}" != "yes" ] && [ -f "${CONFIG_FILE}" ]; then
        log_msg "Preserving existing config (${CONFIG_FILE}), skip openclaw setup and default patch"
        return 0
    fi

    log_msg "Running openclaw setup to initialize configuration..."

    # 2. 执行基础初始化
    "${NODE_BIN}" "${OPENCLAW_BIN}" setup >> ${LOG_FILE} 2>&1
    # 将配置写入到当前用户的目录中，并且确保它能被后续的 Node.js 脚本访问到

    if [ $? -eq 0 ]; then
        log_msg "openclaw setup executed successfully"
    else
        # 此时具体报错已经进入了 LOG_FILE 并且可能在控制台显示
        echo "Failed to execute openclaw setup. Full trace below:" > "${TRIM_TEMP_LOGFILE}"
        # 增加捕捉行数，因为 Node.js 的 Stack Trace（堆栈跟踪）通常比较长
        tail -n 50 "${LOG_FILE}" >> "${TRIM_TEMP_LOGFILE}"
        exit 1
    fi

    log_msg "Injecting gateway.mode=local into configuration..."

    if ! resolve_config_patch_script; then
        log_msg "Failed to locate config patch script under ${TARGET}"
        echo "Failed to locate config patch script under ${TARGET}" >> "${TRIM_TEMP_LOGFILE}"
        tail -n 20 "${LOG_FILE}" >> "${TRIM_TEMP_LOGFILE}"
        exit 1
    fi

    "${NODE_BIN}" "${CONFIG_PATCH_SCRIPT}" >> ${LOG_FILE} 2>&1

    if [ $? -eq 0 ]; then
        log_msg "openclaw configuration initialized and patched successfully"
        return 0
    else
        log_msg "Failed to patch openclaw configuration"
        echo "Failed to patch openclaw configuration" >> "${TRIM_TEMP_LOGFILE}"
        tail -n 20 "${LOG_FILE}" >> "${TRIM_TEMP_LOGFILE}"
        exit 1
    fi
}

generate_oc_token() {
    log_msg "Starting OpenClaw gateway via nohup to generate token..."
    local TOKEN_WAIT_SECONDS="${OC_TOKEN_WAIT_SECONDS:-30}"

    # 1. 定义真实的 JS 入口路径（绕过 .bin 软链接，防止环境问题）
    local OC_JS_PATH="${PKGVAR}/node_modules/openclaw/dist/index.js"
    if [ ! -f "${OC_JS_PATH}" ]; then
        log_msg "Gateway entry not found: ${OC_JS_PATH}"
        echo "Gateway entry not found: ${OC_JS_PATH}" > "${TRIM_TEMP_LOGFILE}"
        exit 1
    fi

    # 2. 杀掉可能残留的旧进程，确保端口清空
    pkill -f "openclaw/dist/index.js gateway" 2>/dev/null
    sleep 1

    # 3. 使用 nohup 在后台启动，绑定 Gateway 端口，日志追加到 LOG_FILE
    nohup env HOME="${HOME}" OPENCLAW_CONFIG_PATH="${OPENCLAW_CONFIG_PATH}" GATEWAY_PORT="${GATEWAY_PORT}" \
    "${NODE_BIN}" "${OC_JS_PATH}" gateway --port "${GATEWAY_PORT}" >> "${LOG_FILE}" 2>&1 &

    # 4. 抓取刚才放入后台的进程 PID
    local GW_PID=$!
    log_msg "Gateway started in background with PID: $GW_PID"

    # 5. 等待最多 TOKEN_WAIT_SECONDS 秒，兼容慢机器/慢存储环境
    log_msg "Waiting up to ${TOKEN_WAIT_SECONDS}s for gateway stabilization..."
    local i
    for i in $(seq 1 "${TOKEN_WAIT_SECONDS}"); do
        if kill -0 "${GW_PID}" 2>/dev/null || pgrep -f "openclaw/dist/index.js gateway" >/dev/null 2>&1; then
            log_msg "OpenClaw gateway process detected as running"
            return 0
        fi
        sleep 1
    done

    # 如果到了这里仍未检测到进程，说明启动后很快崩溃了
    log_msg "Failed to start OpenClaw gateway or generate token"
    echo "Failed to start OpenClaw gateway. Process crashed shortly after startup." > "${TRIM_TEMP_LOGFILE}"
    tail -n 30 "${LOG_FILE}" >> "${TRIM_TEMP_LOGFILE}"
    exit 1
}

snapshot_initial_config() {
    local CONFIG_FILE="${OPENCLAW_CONFIG_PATH}"
    local INITIAL_CONFIG_FILE="${OPENCLAW_CONFIG_PATH}.initial"

    if [ ! -f "${CONFIG_FILE}" ]; then
        log_msg "Skip initial snapshot: ${CONFIG_FILE} not found"
        return 0
    fi

    if [ -f "${INITIAL_CONFIG_FILE}" ]; then
        log_msg "Initial snapshot already exists: ${INITIAL_CONFIG_FILE}"
        return 0
    fi

    cp "${CONFIG_FILE}" "${INITIAL_CONFIG_FILE}" >> "${LOG_FILE}" 2>&1
    if [ $? -eq 0 ]; then
        log_msg "Initial configuration snapshot created: ${INITIAL_CONFIG_FILE}"
    else
        log_msg "Failed to create initial configuration snapshot"
        echo "Failed to create initial configuration snapshot" >> "${TRIM_TEMP_LOGFILE}"
        tail -n 20 "${LOG_FILE}" >> "${TRIM_TEMP_LOGFILE}"
        exit 1
    fi
}

setup_environment_variables() {
    if [ "${TRIM_WIZARD_add_to_path}" != "true" ]; then
        log_msg "User opted out of adding to PATH, skipping environment setup"
        return 0
    fi

    log_msg "Adding OpenClaw, Node.js and Python to system PATH..."

    local PROFILE_FILE="/etc/profile.d/openclaw.sh"

    cat > "${PROFILE_FILE}" << ENVEOF
# OpenClaw, Node.js and Python environment variables
export PATH="/var/apps/nodejs_v22/target/bin:/var/apps/python312/target/bin:${PKGVAR}/node_modules/.bin:\$PATH"
ENVEOF

    if [ $? -eq 0 ]; then
        chmod +x "${PROFILE_FILE}"
        log_msg "Environment variables configured successfully"
    else
        log_msg "Failed to configure environment variables"
        echo "Failed to configure environment variables" >> "${TRIM_TEMP_LOGFILE}"
        tail -n 20 "${LOG_FILE}" >> "${TRIM_TEMP_LOGFILE}"
        exit 1
    fi
}

# entry point
resolve_runtime_binaries

# 步骤 2: 安装 openclaw
install_openclaw

# -----------------
# 执行配置初始化流程
log_msg "Starting OpenClaw configuration setup..."

# 运行 openclaw setup
setup_openclaw_config
generate_oc_token
snapshot_initial_config
setup_environment_variables

exit 0
