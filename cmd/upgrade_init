#!/bin/bash

### This script is called before the user upgrades the application.

set -euo pipefail

APP_NAME="${TRIM_APPNAME:-oc-deploy}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 自动检测配置文件位置（优先匹配已存在的 openclaw.json，避免目录残留误判）
APPDIR_OC_HOME="/var/apps/${APP_NAME}/var/.openclaw"
ROOT_OC_HOME="/root/.openclaw"

if [ -n "${OC_HOME:-}" ] && [ -f "${OC_HOME}/openclaw.json" ]; then
    SRC_DIR="${OC_HOME}"
elif [ -f "${APPDIR_OC_HOME}/openclaw.json" ]; then
    SRC_DIR="${APPDIR_OC_HOME}"
elif [ -f "${ROOT_OC_HOME}/openclaw.json" ]; then
    SRC_DIR="${ROOT_OC_HOME}"
elif [ -n "${OC_HOME:-}" ] && [ -d "${OC_HOME}" ]; then
    SRC_DIR="${OC_HOME}"
elif [ -d "${APPDIR_OC_HOME}" ]; then
    SRC_DIR="${APPDIR_OC_HOME}"
elif [ -d "${ROOT_OC_HOME}" ]; then
    SRC_DIR="${ROOT_OC_HOME}"
else
    SRC_DIR="${OC_HOME:-${ROOT_OC_HOME}}"
fi

PKG_VAR_DIR="${TRIM_PKGVAR:-/var/apps/${APP_NAME}/var}"
TRIM_PKGVAR="${PKG_VAR_DIR}"
OC_HOME="${SRC_DIR}"
BACKUP_ROOT="${OC_DEPLOY_BACKUP_ROOT:-/root/oc-deploy}"
STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP_DIR="${BACKUP_ROOT}/${STAMP}-backup"
MARKER_FILE="${BACKUP_ROOT}/.upgrade_backup_path"
MANIFEST_FILE="${BACKUP_DIR}/manifest.tsv"
BACKUP_ITEMS=0

# shellcheck source=cmd/lib/backup_specs.sh
source "${SCRIPT_DIR}/lib/backup_specs.sh"

backup_entry() {
    local src="$1"
    local rel="$2"
    local item_type="$3"

    if [ ! -e "${src}" ]; then
        echo "[upgrade_init] Skip missing path: ${src}"
        return 0
    fi

    BACKUP_ITEMS=$((BACKUP_ITEMS + 1))

    if [ "${item_type}" = "file" ]; then
        mkdir -p "$(dirname "${BACKUP_DIR}/${rel}")"
        cp -a "${src}" "${BACKUP_DIR}/${rel}"
        printf '%s|%s|file\n' "${src}" "${rel}" >> "${MANIFEST_FILE}"
    else
        mkdir -p "${BACKUP_DIR}/${rel}"
        cp -a "${src}/." "${BACKUP_DIR}/${rel}/"
        printf '%s|%s|dir\n' "${src}" "${rel}" >> "${MANIFEST_FILE}"
    fi

    echo "[upgrade_init] Backed up ${src} -> ${BACKUP_DIR}/${rel}"
}

backup_spec_entry() {
    local _id="$1"
    local item_type="$2"
    local rel="$3"
    local target_path="$4"

    backup_entry "${target_path}" "${rel}" "${item_type}"
}

mkdir -p "${BACKUP_ROOT}" "${BACKUP_DIR}"
printf '# target|backup_rel|type\n' > "${MANIFEST_FILE}"

each_backup_spec backup_spec_entry

if [ "${BACKUP_ITEMS}" -eq 0 ]; then
    echo "[upgrade_init] No backup sources found, skip."
    rm -rf "${BACKUP_DIR}"
    rm -f "${MARKER_FILE}"
    exit 0
fi

echo "${BACKUP_DIR}" > "${MARKER_FILE}"

echo "[upgrade_init] Backup created at ${BACKUP_DIR} (items=${BACKUP_ITEMS})"
exit 0
