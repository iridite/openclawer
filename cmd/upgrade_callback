#!/bin/bash

### This script is called after the user upgrades the application.

set -euo pipefail

APP_NAME="${TRIM_APPNAME:-oc-deploy}"

# 自动检测配置文件位置
if [ -d "/var/apps/${APP_NAME}/var/.openclaw" ]; then
    SRC_DIR="/var/apps/${APP_NAME}/var/.openclaw"
elif [ -d "/root/.openclaw" ]; then
    SRC_DIR="/root/.openclaw"
else
    SRC_DIR="${OC_HOME:-/root/.openclaw}"
fi

BACKUP_ROOT="${OC_DEPLOY_BACKUP_ROOT:-/root/oc-deploy}"
MARKER_FILE="${BACKUP_ROOT}/.upgrade_backup_path"
RESTORED_ITEMS=0
NODE_PATH="${NODE_PATH:-/var/apps/nodejs_v22/target/bin/node}"

migrate_legacy_config_file() {
    local config_file="$1"
    local node_bin="${NODE_PATH}"

    if [ ! -f "${config_file}" ]; then
        return 0
    fi

    if [ ! -x "${node_bin}" ]; then
        node_bin="$(command -v node || true)"
    fi

    if [ -z "${node_bin}" ]; then
        echo "[upgrade_callback] Skip migration for ${config_file}: node not found"
        return 0
    fi

    if "${node_bin}" - "${config_file}" <<'NODE'
const fs = require("fs");

const filePath = process.argv[2];
const LEGACY_PROVIDER = "ocDeployFile";
const NEXT_PROVIDER = "oc-deploy-file";

function isObjectLike(value) {
  return value && typeof value === "object" && !Array.isArray(value);
}

function rewriteLegacyProvider(node) {
  if (!node || typeof node !== "object") {
    return false;
  }

  let changed = false;
  if (Array.isArray(node)) {
    for (const item of node) {
      if (rewriteLegacyProvider(item)) {
        changed = true;
      }
    }
    return changed;
  }

  if (
    String(node.source || "").toLowerCase() === "file" &&
    node.provider === LEGACY_PROVIDER
  ) {
    node.provider = NEXT_PROVIDER;
    changed = true;
  }

  for (const value of Object.values(node)) {
    if (rewriteLegacyProvider(value)) {
      changed = true;
    }
  }

  return changed;
}

let config = null;
try {
  const raw = fs.readFileSync(filePath, "utf8");
  config = JSON.parse(raw);
} catch (err) {
  console.error(`[upgrade_callback] Failed to parse ${filePath}: ${err.message}`);
  process.exit(1);
}

if (!isObjectLike(config)) {
  process.exit(0);
}

let changed = false;

const providers = isObjectLike(config?.secrets?.providers)
  ? config.secrets.providers
  : null;
if (providers && Object.prototype.hasOwnProperty.call(providers, LEGACY_PROVIDER)) {
  if (!Object.prototype.hasOwnProperty.call(providers, NEXT_PROVIDER)) {
    providers[NEXT_PROVIDER] = providers[LEGACY_PROVIDER];
  }
  delete providers[LEGACY_PROVIDER];
  changed = true;
}

const defaults = isObjectLike(config?.secrets?.defaults)
  ? config.secrets.defaults
  : null;
if (defaults && defaults.file === LEGACY_PROVIDER) {
  defaults.file = NEXT_PROVIDER;
  changed = true;
}

if (rewriteLegacyProvider(config)) {
  changed = true;
}

if (!changed) {
  process.exit(0);
}

try {
  fs.writeFileSync(filePath, JSON.stringify(config, null, 2), "utf8");
} catch (err) {
  console.error(`[upgrade_callback] Failed to write ${filePath}: ${err.message}`);
  process.exit(1);
}
NODE
    then
        echo "[upgrade_callback] Migrated legacy secret provider in ${config_file}"
    else
        echo "[upgrade_callback] Warning: config migration failed for ${config_file}"
    fi
}

migrate_restored_configs() {
    local candidates=(
        "${SRC_DIR}/openclaw.json"
        "/root/.openclaw/openclaw.json"
        "/var/apps/${APP_NAME}/var/.openclaw/openclaw.json"
    )

    local cfg=""
    for cfg in "${candidates[@]}"; do
        migrate_legacy_config_file "${cfg}"
    done
}

restore_entry() {
    local target="$1"
    local rel="$2"
    local item_type="$3"
    local backup_path="${BACKUP_DIR}/${rel}"

    if [ ! -e "${backup_path}" ]; then
        echo "[upgrade_callback] Skip missing backup path: ${backup_path}"
        return 0
    fi

    if [ "${item_type}" = "file" ]; then
        mkdir -p "$(dirname "${target}")"
        cp -a "${backup_path}" "${target}"
    else
        mkdir -p "${target}"
        cp -a "${backup_path}/." "${target}/"
    fi

    RESTORED_ITEMS=$((RESTORED_ITEMS + 1))
    echo "[upgrade_callback] Restored ${backup_path} -> ${target}"
}

if [ -f "${MARKER_FILE}" ]; then
    BACKUP_DIR="$(cat "${MARKER_FILE}")"
else
    BACKUP_DIR="$(ls -1dt "${BACKUP_ROOT}"/*-backup 2>/dev/null | head -n 1 || true)"
fi

if [ -z "${BACKUP_DIR}" ] || [ ! -d "${BACKUP_DIR}" ]; then
    echo "[upgrade_callback] Backup not found, skip restore."
    exit 0
fi

MANIFEST_FILE="${BACKUP_DIR}/manifest.tsv"
if [ -f "${MANIFEST_FILE}" ]; then
    while IFS='|' read -r target rel item_type; do
        [ -z "${target}" ] && continue
        case "${target}" in
            \#*) continue ;;
        esac
        restore_entry "${target}" "${rel}" "${item_type:-dir}"
    done < "${MANIFEST_FILE}"
else
    # Backward compatibility: restore legacy backup layout
    if [ -d "${BACKUP_DIR}/.openclaw" ]; then
        mkdir -p "${SRC_DIR}"
        cp -a "${BACKUP_DIR}/.openclaw/." "${SRC_DIR}/"
        RESTORED_ITEMS=$((RESTORED_ITEMS + 1))
        echo "[upgrade_callback] Restored legacy .openclaw from ${BACKUP_DIR}"
    fi
fi

if [ "${RESTORED_ITEMS}" -eq 0 ]; then
    echo "[upgrade_callback] No restorable items found in ${BACKUP_DIR}"
    exit 0
fi

migrate_restored_configs

rm -f "${MARKER_FILE}" || true
echo "[upgrade_callback] Restored from ${BACKUP_DIR} (items=${RESTORED_ITEMS})"
exit 0
